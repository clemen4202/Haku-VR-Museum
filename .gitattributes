###############################################################################
# Haku VR Museum — .gitattributes
#
# Rule: Unity YAML stays TEXT so it can diff and merge. Only true binaries go
# to Git LFS.
#
# 🚨 LFS TRACKING IS NOT RETROACTIVE. A .fbx or .png committed BEFORE this file
# existed is stored as a raw blob in history FOREVER, and it keeps counting
# against the 10 GiB storage allowance after you "fix" it. The only repair is
# `git lfs migrate import --everything` plus a force-push that rewrites history
# for all six of us. This file must be in commit #1, before any art lands.
#
# PATTERN RULE: a pattern with NO slash (*.fbx) matches at any depth, so this
# one root file covers unity/ and ai-service/ alike. A pattern CONTAINING a
# slash anchors to this directory — which is why the last line uses the bare
# filename.
#
# Verify after committing:
#   git check-attr filter -- unity/Assets/test.fbx        -> filter: lfs
#   git check-attr diff   -- unity/Packages/packages-lock.json -> diff: unset
###############################################################################
# --- 1. Line-ending normalisation -------------------------------------------
* text=auto
# --- 2. Unity YAML: TEXT, LF, routed through Unity SmartMerge. NEVER LFS. ----
# Scenes and prefabs must stay plain text or diff, merge and code review all
# die. `lockable` works without filter=lfs and is what makes `git lfs lock`
# usable on scenes (see docs/SETUP.md, scene ownership).
*.unity              text eol=lf merge=unityyamlmerge lockable
*.prefab             text eol=lf merge=unityyamlmerge
*.asset              text eol=lf merge=unityyamlmerge
*.mat                text eol=lf merge=unityyamlmerge
*.anim               text eol=lf merge=unityyamlmerge
*.controller         text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial     text eol=lf merge=unityyamlmerge
*.playable           text eol=lf merge=unityyamlmerge
*.mask               text eol=lf merge=unityyamlmerge
*.renderTexture      text eol=lf merge=unityyamlmerge
*.mixer              text eol=lf merge=unityyamlmerge
*.preset             text eol=lf merge=unityyamlmerge
*.meta               text eol=lf merge=unityyamlmerge
# --- 3. Source and config: text, no LFS -------------------------------------
*.cs          text eol=lf diff=csharp
*.shader      text eol=lf
*.shadergraph text eol=lf
*.hlsl        text eol=lf
*.asmdef      text eol=lf
*.uxml        text eol=lf
*.uss         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.xml         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.py          text eol=lf
*.toml        text eol=lf
*.sh          text eol=lf
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf
# --- 4. Git LFS: genuine binaries only --------------------------------------
# 3D models
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.FBX    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text
# .gltf is technically JSON, but it is meaningless without its .bin/.glb
# payload and nobody will ever read its diff. Kept beside the binary on purpose.
*.gltf   filter=lfs diff=lfs merge=lfs -text
# Textures / images
*.png    filter=lfs diff=lfs merge=lfs -text
*.PNG    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.JPG    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.TGA    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
# Audio
*.wav    filter=lfs diff=lfs merge=lfs -text
*.WAV    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
# Unity packages
*.unitypackage filter=lfs diff=lfs merge=lfs -text
# Native libraries and plugin symbols.
# NOTE: *.pdb and *.mdb are .gitignore'd (they are IL2CPP / Visual Studio
# output). .gitignore wins over .gitattributes, so these rules only ever apply
# to a symbol file deliberately force-added alongside a native plugin.
*.dll    filter=lfs diff=lfs merge=lfs -text
*.so     filter=lfs diff=lfs merge=lfs -text
*.a      filter=lfs diff=lfs merge=lfs -text
*.mdb    filter=lfs diff=lfs merge=lfs -text
*.pdb    filter=lfs diff=lfs merge=lfs -text
# DELIBERATELY NOT TRACKED: *.onnx and *.onnx.json. Those are Piper voice
# weights and they are .gitignore'd — routing them into LFS would be an
# invitation to commit 63 MB of model per voice.
# --- 5. Suppress diff noise on generated lock files -------------------------
# Bare filename, NO leading slash. A slashed path would anchor to the repo root
# and silently never match unity/Packages/packages-lock.json.
packages-lock.json  -diff
